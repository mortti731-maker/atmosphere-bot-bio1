# Пример файла .env для Telegram Bio Bot

# ОБЯЗАТЕЛЬНО: Токен вашего Telegram бота
# Получите его у @BotFather в Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Домен вашего сервера (для production)
# Для локального тестирования используйте 'localhost'
DOMAIN=localhost

# Порт сервера
PORT=3000

# Режим работы бота
# false - использовать polling (для локального тестирования)
# true - использовать вебхуки (для production)
USE_WEBHOOK=false

# URL для вебхука (нужен только если USE_WEBHOOK=true)
# Пример: https://your-domain.com/webhook
WEBHOOK_URL=

# Режим окружения
NODE_ENV=development